<acl>
  <page-system-localduo>
    <name>System: Duo API connection test</name>
    <patterns>
      <pattern>api/localduo/settings/check</pattern>
    </patterns>
  </page-system-localduo>
  <page-system-localduo-login-progress>
    <name>System: Duo login progress management</name>
    <patterns>
      <pattern>api/localduo/settings/loginstatus</pattern>
      <pattern>api/localduo/settings/loginenable</pattern>
      <pattern>api/localduo/settings/logindisable</pattern>
    </patterns>
  </page-system-localduo-login-progress>
</acl>
